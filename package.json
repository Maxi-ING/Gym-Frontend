{
  "name": "fitanalytics-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "skills:install": "npx -y skills@latest add pbakaus/impeccable --skill impeccable --agent codex -y && npx -y skills@latest add emilkowalski/skills --skill emil-design-eng --agent codex -y && npx -y skills@latest add Leonxlnx/taste-skill --skill design-taste-frontend --agent codex -y"
  },
  "dependencies": {
    "chart.js": "4.5.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
}
